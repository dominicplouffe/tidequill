<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seo.title }}</title>
<meta name="description" content="{{ seo.description }}">
<link rel="canonical" href="{{ seo.canonical }}">
{%- if seo.noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta property="og:type" content="{{ seo.ogType }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ seo.ogTitle }}">
<meta property="og:description" content="{{ seo.description }}">
<meta property="og:url" content="{{ seo.canonical }}">
<meta property="og:locale" content="{{ site.ogLocale }}">
{%- if seo.image %}
<meta property="og:image" content="{{ seo.image }}">
<meta property="og:image:alt" content="{{ seo.imageAlt }}">
{%- endif %}
{%- if seo.published %}
<meta property="article:published_time" content="{{ seo.published }}">
<meta property="article:modified_time" content="{{ seo.modified }}">
{%- endif %}
<meta name="twitter:card" content="{{ seo.twitterCard }}">
<meta name="twitter:title" content="{{ seo.ogTitle }}">
<meta name="twitter:description" content="{{ seo.description }}">
{%- if seo.markdown %}
<link rel="alternate" type="text/markdown" href="{{ seo.markdown }}">
{%- endif %}
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="/feed.xml">
{%- if css.preload %}
<link rel="preload" href="/_tq/fonts/{{ css.preload }}" as="font" type="font/woff2" crossorigin>
{%- endif %}
<style>{{ css.inline | raw }}</style>
{%- if seo.jsonLd %}
<script type="application/ld+json">{{ seo.jsonLd | raw }}</script>
{%- endif %}
</head>
<body class="tq-{{ page.kind }}">
<a class="skip" href="#main">Skip to content</a>
{% render 'header', site: site %}
<main id="main">
{% block content %}{% endblock %}
</main>
{% render 'footer', site: site %}
{{ page.tail | raw }}
</body>
</html>
