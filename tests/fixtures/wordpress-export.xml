	<item>
		<title><![CDATA[How to Pick a TV Stand]]></title>
		<link>https://oakandpine.example/2019/05/how-to-pick-a-tv-stand/</link>
		<pubDate>Tue, 14 May 2019 10:00:00 +0000</pubDate>
		<dc:creator><![CDATA[fred]]></dc:creator>
		<guid isPermaLink="false">https://oakandpine.example/?p=100</guid>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>I bought the <strong>wrong</strong> stand first. Read <a href="https://oakandpine.example/about/">about us</a> to see why we test everything &amp; measure twice.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2>How wide should the stand be?</h2>
<!-- /wp:heading -->

<!-- wp:list -->
<ul><li>Measure the <em>feet</em> of the TV</li><li>Add six inches</li></ul>
<!-- /wp:list -->

<!-- wp:image {"id":50} -->
<figure class="wp-block-image"><img src="https://oakandpine.example/wp-content/uploads/2019/05/oak-stand-1024x683.jpg" alt="" class="wp-image-50"/><figcaption>Our oak stand after six months</figcaption></figure>
<!-- /wp:image -->

<!-- wp:table -->
<figure class="wp-block-table"><table><thead><tr><th>TV</th><th>Stand width</th></tr></thead><tbody><tr><td>65"</td><td>60 in</td></tr><tr><td>77"</td><td>70 in</td></tr></tbody></table></figure>
<!-- /wp:table -->

<!-- wp:quote -->
<blockquote class="wp-block-quote"><p>Measure twice, buy once.</p><cite>Fred</cite></blockquote>
<!-- /wp:quote -->

[contact-form-7 id="12" title="Contact form 1"]

[caption id="attachment_51" align="aligncenter" width="300"]<img src="https://cdn.elsewhere.example/walnut.jpg" alt="Walnut console" width="300" height="200" /> A walnut console we liked[/caption]

<!-- wp:paragraph -->
<p>Questions? See the <a href="/2019/05/old-style/">older post</a>.</p>
<!-- /wp:paragraph -->]]></content:encoded>
